# Variáveis de ambiente do site. Copie para .env.local (desenvolvimento) ou
# configure no painel da hospedagem (produção). Nunca publique o arquivo real.
#
# Todos os valores abaixo são exemplos falsos. Os campos vazios ficam vazios de
# propósito: preenchidos com um exemplo, abririam uma brecha se fossem copiados
# sem revisão. Sem entrega válida, o formulário responde "indisponível" e
# nunca finge que enviou. NODE_ENV é definido pelo Next.js; não o defina aqui.
# Detalhes em docs/backend-agendamento.md.

# --- Site ---------------------------------------------------------------------

# Endereço público canônico (metadados, redirecionamento HTTPS e origem aceita pela API).
SITE_URL=https://www.seudominio.com.br
# Alternativa a SITE_URL lida pelos metadados. Prefira SITE_URL.
NEXT_PUBLIC_SITE_URL=
# Link opcional de um sistema de reservas externo, exibido junto ao formulário.
# NEXT_PUBLIC_*: o valor é embutido no JavaScript no momento do build.
NEXT_PUBLIC_BOOKING_URL=

# Outras origens aceitas pela API, separadas por vírgula (por exemplo, o domínio sem "www").
ALLOWED_ORIGINS=https://seudominio.com.br

# --- Entrega das solicitações -------------------------------------------------

# "resend" (e-mail para a recepção) ou "webhook" (sistema de agenda, n8n, Make).
BOOKING_DELIVERY=resend

# Resend: chave da API (começa com re_), remetente de um domínio verificado e destino.
# O destino fica vazio de propósito: um endereço de exemplo esquecido mandaria os
# dados das pessoas para um domínio de terceiros. Exemplo: recepcao@suaclinica.com.br
RESEND_API_KEY=re_xxxxxxxx
BOOKING_EMAIL_FROM="Oralé Studio <agendamento@seudominio.com.br>"
BOOKING_EMAIL_TO=

# Webhook: URL HTTPS do receptor e segredo HMAC com pelo menos 32 caracteres.
# A URL fica vazia pelo mesmo motivo do destino do e-mail. Exemplo:
# https://hooks.suaclinica.com.br/agendamento. HTTP sem TLS só é aceito em
# produção para loopback (127.0.0.1, [::1], localhost), como um receptor local.
# Gere o segredo com: openssl rand -hex 32
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=gere-com-openssl-rand-hex-32

# --- Anti-robô (Cloudflare Turnstile, opcional) -------------------------------

# Ativo somente com as duas chaves preenchidas. A chave do site é pública
# (vai para o navegador); a secreta fica só no servidor.
# Para testes locais, a Cloudflare oferece chaves públicas de teste:
#   site 1x00000000000000000000AA e secreta 1x0000000000000000000000000000000AA (sempre aprovam)
#   site 2x00000000000000000000AB (sempre bloqueia) e secreta 2x0000000000000000000000000000000AA (sempre recusa)
# Nunca use as chaves de teste em produção.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Proxy reverso e limite de requisições ------------------------------------

# "true" somente atrás de um proxy que SOBRESCREVE o cabeçalho do IP do cliente.
# Sem proxy confiável, qualquer visitante poderia forjar o cabeçalho, e todos
# os visitantes dividem um único limite de envios.
TRUST_PROXY=false
# Quantos proxies confiáveis ACRESCENTAM o IP ao cabeçalho (1 a 5). O IP é lido
# da direita para a esquerda, porque os valores à esquerda vêm do próprio
# cliente. Use 1 para um proxy (nginx, ALB) e 2 para Cloudflare + nginx, ou
# prefira CLIENT_IP_HEADER=cf-connecting-ip atrás da Cloudflare.
TRUST_PROXY_HOPS=1
# Cabeçalho com o IP do cliente: x-forwarded-for, x-real-ip (nginx), cf-connecting-ip (Cloudflare).
CLIENT_IP_HEADER=x-forwarded-for
# Sal do hash de IP no limitador. Vazio = valor aleatório por processo.
# Defina (openssl rand -hex 32) se usar um armazenamento compartilhado entre instâncias.
RATE_LIMIT_SALT=

# --- Cabeçalhos de segurança --------------------------------------------------

# Redireciona HTTP para HTTPS (use atrás de proxy que envie X-Forwarded-Proto).
FORCE_HTTPS=false
# Envia Strict-Transport-Security. Ative só depois de confirmar o HTTPS do domínio.
HSTS_ENABLED=false
# Endpoint opcional para relatórios de violação da CSP: URL https ou caminho do
# próprio site (/csp). Outros valores são ignorados.
CSP_REPORT_URI=

# --- Somente testes (lidas pelo Playwright e pelo receptor local, não pelo site) ---
# Defina no terminal ao rodar os testes; o Playwright não lê este arquivo.
# E2E_PORT=3100
# E2E_WEBHOOK_PORT=4010
# PLAYWRIGHT_CHROMIUM_PATH=/caminho/para/chromium
# MOCK_WEBHOOK_PORT=4010
# MOCK_WEBHOOK_FAIL=1
# MOCK_WEBHOOK_DUMP=.e2e/last-webhook.json
